-  test("policy exposes endpoint") {
-    val config = Config(9000, "postgres://db/service", 45)
-    assertEquals(new SessionPolicy(config, Map.empty).endpoint, config.databaseUrl)
+
+  test("uses documented defaults for optional numeric settings") {
+    assertEquals(Config.load(Map("DATABASE_URL" -> "postgres://db/service")),
+      Config(8080, "postgres://db/service", 60))
+  }
+
+  test("rejects missing or blank database URL") {
+    for env <- List(Map.empty[String, String], Map("DATABASE_URL" -> "  ")) do
+      val error = intercept[IllegalArgumentException](Config.load(env))
+      assert(error.getMessage.contains("DATABASE_URL"))
+  }
+
+  test("rejects malformed and nonpositive numeric settings by name") {
+    for (name, value) <- List("PORT" -> "oops", "PORT" -> "0", "SESSION_TTL_MINUTES" -> "1.5") do
+      val error = intercept[IllegalArgumentException](Config.load(Map("DATABASE_URL" -> "postgres://db/service", name -> value)))
+      assert(error.getMessage.contains(name))
+  }
+
+  test("session policy uses the immutable loaded configuration") {
+    val config = Config.load(Map("DATABASE_URL" -> "postgres://db/service", "SESSION_TTL_MINUTES" -> "45"))
+    val mutableSource = scala.collection.mutable.Map("SESSION_TTL_MINUTES" -> "45")
+    val policy = new SessionPolicy(config, mutableSource.toMap)
+    mutableSource.update("SESSION_TTL_MINUTES", "10")
+    assertEquals(policy.expiresAfterMinutes, 45)
+    assertEquals(policy.endpoint, config.databaseUrl)
   }
