+  private def requiredPositiveInt(env: Map[String, String], setting: String): Int =
+    val value = env.get(setting).flatMap(_.toIntOption).filter(_ > 0).getOrElse {
+      throw new IllegalArgumentException(s"Missing or unusable setting $setting (expected a positive integer)")
+    }
+    value
