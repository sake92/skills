diff --git a/src/main/scala/service/Sessions.scala b/src/main/scala/service/Sessions.scala
index 43a07b8..f4ba821 100644
--- a/src/main/scala/service/Sessions.scala
+++ b/src/main/scala/service/Sessions.scala
@@ -15,11 +15,20 @@ final class SharedStore extends SessionStore:
     entries.remove(token); ()
 
 final class Sessions(store: SessionStore, emit: String => Unit):
-  private val local = mutable.Map.empty[String, String]
   def signIn(token: String, user: String, requestId: String): Unit =
-    local.update(token, user)
-    emit(s"Signed in $user with token $token")
-  def currentUser(token: String): Option[String] = local.get(token)
+    store.put(token, user)
+    emit(record("info", "session_signed_in", requestId))
+  def currentUser(token: String): Option[String] = store.get(token)
   def signOut(token: String, requestId: String): Unit =
-    local.remove(token)
-    emit(s"Signed out token $token")
+    store.remove(token)
+    emit(record("info", "session_signed_out", requestId))
+
+  private def record(level: String, event: String, requestId: String): String =
+    // JSON escaping keeps request identifiers safe for the collector's one-record-per-line format.
+    val safeId = requestId.flatMap {
+      case '"' => "\\\""
+      case '\\' => "\\\\"
+      case c if c < ' ' => f"\\u${c.toInt}%04x"
+      case c => c.toString
+    }
+    s"{\"level\":\"$level\",\"event\":\"$event\",\"request_id\":\"$safeId\"}"
diff --git a/src/test/scala/service/SessionsSuite.scala b/src/test/scala/service/SessionsSuite.scala
index 70835d4..133d0ac 100644
--- a/src/test/scala/service/SessionsSuite.scala
+++ b/src/test/scala/service/SessionsSuite.scala
@@ -11,3 +11,26 @@ class SessionsSuite extends munit.FunSuite:
   test("unknown session is absent") {
     assertEquals(new Sessions(new SharedStore, _ => ()).currentUser("missing"), None)
   }
+  test("sessions survive replacing an instance and sign-out is visible to every replica") {
+    val store = new SharedStore
+    val first = new Sessions(store, _ => ())
+    first.signIn("token", "ada", "r-signin")
+
+    val replacement = new Sessions(store, _ => ())
+    assertEquals(replacement.currentUser("token"), Some("ada"))
+    replacement.signOut("token", "r-signout")
+    assertEquals(first.currentUser("token"), None)
+  }
+  test("logs are structured, traceable, and never contain session tokens") {
+    val records = scala.collection.mutable.ArrayBuffer.empty[String]
+    val sessions = new Sessions(new SharedStore, records += _)
+    sessions.signIn("secret-token", "ada", "request-42")
+    sessions.signOut("secret-token", "request-43")
+
+    assertEquals(records.size, 2)
+    assert(records.forall(_.startsWith("{")))
+    assert(records.exists(_.contains("\"level\":\"info\"")))
+    assert(records.exists(_.contains("request-42")))
+    assert(records.exists(_.contains("request-43")))
+    assert(!records.exists(_.contains("secret-token")))
+  }
