@@ -10,7 +10,30 @@ class ConfigSuite extends munit.FunSuite:
     )
     assertEquals(Config.load(env), Config(9000, "postgres://db/service", 45))
   }
-  test("policy exposes endpoint") {
+  test("policy exposes endpoint and uses immutable config for expiry") {
     val config = Config(9000, "postgres://db/service", 45)
-    assertEquals(new SessionPolicy(config, Map.empty).endpoint, config.databaseUrl)
+    val rawEnvironment = scala.collection.mutable.Map("SESSION_TTL_MINUTES" -> "10")
+    val policy = new SessionPolicy(config, rawEnvironment.toMap)
+    assertEquals(policy.endpoint, config.databaseUrl)
+    assertEquals(policy.expiresAfterMinutes, 45)
+    rawEnvironment.update("SESSION_TTL_MINUTES", "99")
+    assertEquals(policy.expiresAfterMinutes, 45)
+  }
+
+  test("database URL is used regardless of descriptive APP_ENV") {
+    assertEquals(Config.load(Map("APP_ENV" -> "staging", "PORT" -> "9000", "DATABASE_URL" -> "postgres://staging/db", "SESSION_TTL_MINUTES" -> "45")).databaseUrl, "postgres://staging/db")
+  }
+
+  test("missing required configuration names the setting") {
+    for name <- List("PORT", "DATABASE_URL", "SESSION_TTL_MINUTES") do
+      val env = Map("PORT" -> "9000", "DATABASE_URL" -> "postgres://db/service", "SESSION_TTL_MINUTES" -> "45") - name
+      val error = intercept[IllegalArgumentException](Config.load(env))
+      assert(error.getMessage.contains(name))
+  }
+
+  test("malformed and unusable numeric settings fail with setting name") {
+    for (name, value) <- List("PORT" -> "oops", "SESSION_TTL_MINUTES" -> "oops", "PORT" -> "0", "SESSION_TTL_MINUTES" -> "0") do
+      val env = Map("PORT" -> "9000", "DATABASE_URL" -> "postgres://db/service", "SESSION_TTL_MINUTES" -> "45") + (name -> value)
+      val error = intercept[IllegalArgumentException](Config.load(env))
+      assert(error.getMessage.contains(name))
   }
