#!/usr/bin/env bash
# Run the Codeps 0.6.0 CLI, downloading its pinned JAR on first use.
# Usage: bash /path/to/scripts/codeps-cli <codeps-args...>
# CODEPS_JAR overrides the JAR path but must still report version 0.6.0.
# CODEPS_CACHE_DIR overrides the default ~/.cache/codeps directory.
set -euo pipefail

VERSION="0.6.0"
CACHE_DIR="${CODEPS_CACHE_DIR:-$HOME/.cache/codeps}"
RELEASE_URL="https://github.com/sake92/codeps/releases/download/v${VERSION}/codeps-cli-${VERSION}.jar"
JAR="${CODEPS_JAR:-$CACHE_DIR/codeps-cli-${VERSION}.jar}"

if [[ ! -f "$JAR" ]]; then
  if [[ -n "${CODEPS_JAR:-}" ]]; then
    echo "error: CODEPS_JAR is set but file does not exist: $CODEPS_JAR" >&2
    exit 1
  fi
  mkdir -p "$CACHE_DIR"
  echo "Downloading Codeps $VERSION to $JAR ..." >&2
  if ! curl -L --fail --silent --show-error -o "$JAR" "$RELEASE_URL"; then
    echo "error: failed to download Codeps $VERSION ($RELEASE_URL)" >&2
    rm -f "$JAR"
    exit 1
  fi
fi

if ! ACTUAL_VERSION="$(java -jar "$JAR" --version)"; then
  echo "error: cannot read Codeps version from $JAR" >&2
  exit 1
fi
if [[ "$ACTUAL_VERSION" != "$VERSION" ]]; then
  echo "error: this skill requires Codeps $VERSION; $JAR reports $ACTUAL_VERSION" >&2
  exit 1
fi

exec java -jar "$JAR" "$@"
