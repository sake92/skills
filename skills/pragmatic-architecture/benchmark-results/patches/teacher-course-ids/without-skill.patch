--- a/src/test/scala/TeacherSuite.scala
+++ b/src/test/scala/TeacherSuite.scala
@@ -13,6 +13,21 @@ class TeacherSuite extends munit.FunSuite {
     assertEquals(new CourseRoster(service).namesFor(id, List(id)), List(Some("Ada")))
   }
 
+  test("lookup uses user and course in the correct order and isolates cached results") {
+    val user = id
+    val otherUser = UUID.fromString("00000000-0000-0000-0000-000000000003")
+    val course = UUID.fromString("00000000-0000-0000-0000-000000000002")
+    val reversedOnly = TeacherRecord(course, user, "Wrong reversed match")
+    val expected = TeacherRecord(user, course, "Correct teacher")
+    val otherCourse = TeacherRecord(user, otherUser, "Different course")
+    val svc = new TeacherService(new InMemoryTeacherRepository(List(reversedOnly, expected, otherCourse)))
+
+    assertEquals(svc.findByUserIdAndCourseId(user, course), Some(expected))
+    assertEquals(svc.findByUserIdAndCourseId(user, otherUser), Some(otherCourse))
+    assertEquals(svc.findByUserIdAndCourseId(user, course), Some(expected))
+    assertEquals(svc.findByUserIdAndCourseId(course, user), Some(reversedOnly))
+  }
+
   test("absence and malformed URL identifiers") {
