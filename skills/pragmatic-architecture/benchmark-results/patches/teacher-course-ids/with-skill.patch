     }
diff --git a/src/test/scala/TeacherSuite.scala b/src/test/scala/TeacherSuite.scala
index f438bdf..aa9c3c5 100644
--- a/src/test/scala/TeacherSuite.scala
+++ b/src/test/scala/TeacherSuite.scala
@@ -13,6 +13,24 @@ class TeacherSuite extends munit.FunSuite {
     assertEquals(new CourseRoster(service).namesFor(id, List(id)), List(Some("Ada")))
   }
 
+  test("lookup uses user and course in the correct order and isolates repeated queries") {
+    val user = id
+    val course = UUID.fromString("00000000-0000-0000-0000-000000000002")
+    val otherUser = UUID.fromString("00000000-0000-0000-0000-000000000003")
+    val rows = List(
+      TeacherRecord(user, course, "Expected"),
+      TeacherRecord(course, user, "Reversed"),
+      TeacherRecord(otherUser, course, "Other user")
+    )
+    val lookup = new TeacherService(new InMemoryTeacherRepository(rows))
+
+    assertEquals(lookup.findByUserIdAndCourseId(UserId(user), CourseId(course)).map(_.displayName), Some("Expected"))
+    assertEquals(lookup.findByUserIdAndCourseId(UserId(user), CourseId(course)).map(_.displayName), Some("Expected"))
+    assertEquals(lookup.findByUserIdAndCourseId(UserId(otherUser), CourseId(course)).map(_.displayName), Some("Other user"))
+    assertEquals(lookup.findByUserIdAndCourseId(UserId(course), CourseId(user)).map(_.displayName), Some("Reversed"))
+    assertEquals(new TeacherController(lookup).get(user.toString, course.toString), TeacherResponse(200, "Expected"))
+  }
+
   test("absence and malformed URL identifiers") {
     val empty = new TeacherController(new TeacherService(new InMemoryTeacherRepository(Nil)))
     assertEquals(empty.get(id.toString, id.toString), TeacherResponse(404, "teacher not found"))
