@@ -0,0 +1,25 @@
+package customers
+
+import munit.FunSuite
+
+final class InMemoryCustomerRepositorySuite extends FunSuite:
+  private val first = Customer("1", "one@example.com", "north", active = true)
+  private val second = Customer("2", "two@example.com", "south", active = false)
+  private val inactive = Customer("3", "three@example.com", "north", active = false)
+  private val third = Customer("4", "four@example.com", "north", active = true)
+  private val repository = InMemoryCustomerRepository(Seq(first, second, inactive, third))
+
+  test("finds customers by ID and returns None when absent"):
+    assertEquals(repository.findById("1"), Some(first))
+    assertEquals(repository.findById("missing"), None)
+
+  test("finds customers by email and returns None when absent"):
+    assertEquals(repository.findByEmail("two@example.com"), Some(second))
+    assertEquals(repository.findByEmail("missing@example.com"), None)
+
+  test("lists active customers in a region in input order"):
+    assertEquals(repository.activeByRegion("north"), List(first, third))
+
+  test("returns an empty list when a region has no active customers"):
+    assertEquals(repository.activeByRegion("west"), Nil)
+    assertEquals(repository.activeByRegion("south").filterNot(_.active), Nil)
