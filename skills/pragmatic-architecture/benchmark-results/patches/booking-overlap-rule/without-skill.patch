+  test("HTTP rejects any overlapping active interval without persisting it") {
+    val repository = new InMemoryBookingRepository(List(Booking("seed", "room-a", 10, 20)))
+    val controller = new BookingController(new BookingService(repository))
+    assertEquals(controller.create(BookingRequest("overlap", "room-a", 15, 25)),
+      BookingResponse(409, None, Some(BookingError.Overlap)))
+    assertEquals(history(repository).map(_.id), List("seed"))
+    assertEquals(controller.create(BookingRequest("other-room", "room-b", 15, 25)).status, 201)
+    assertEquals(controller.create(BookingRequest("touching", "room-a", 20, 30)).status, 201)
+  }
+
+  test("batch import rejects overlaps, continues in order, and ignores cancelled history") {
+    val repository = new InMemoryBookingRepository(List(Booking("cancelled", "room-a", 10, 20, cancelled = true)))
+    val app = new BookingApplication(repository)
+    val results = app.importer.importBatch(List(
+      BookingRequest("first", "room-a", 10, 20),
+      BookingRequest("overlap", "room-a", 15, 25),
+      BookingRequest("later", "room-a", 20, 30)
+    ))
+    assertEquals(results.map(_.isRight), List(true, false, true))
+    assertEquals(results(1), Left(BookingError.Overlap))
+    assertEquals(app.history.map(_.id), List("cancelled", "first", "later"))
+  }
+
